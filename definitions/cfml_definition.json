{
  "name": "cfml",
  "version": 1.0,
  "caseSensitivity": false,
  "defaultFileExtensions": [
    "cfm",
    "cfc"
  ],
  "otherTextInside": true,
  "mergeSignIntoNumber": {
    "signTokens": [
      "AddOperator"
    ],
    "numberTokens": [
      "Number"
    ],
    "operandTokens": [
      "Number",
      "Variable",
      "Boolean",
      "Function",
      "SingleString",
      "DoubleString",
      "Parenthesis",
      "ArrayIndex",
      "CodeBlock",
      "SharpExpression"
    ]
  },
  "defaultTextEncoding": "latin1",
  "SupportedBom": "UTF-8,UTF-16-LE,UTF-16-BE",
  "startTokens": [
    "ScriptTagPair",
    "OutputTagPair",
    "QueryTagPair",
    "LoopTagPair",
    "MailTagPair",
    "SavecontentTagPair",
    "StartTag",
    "EndTag",
    "Comment"
  ],
  "overrideStartTokens": [
    {
      "if": {
        "fileExtensions": [
          "cfc"
        ],
        "regex": "^\\s*(?:(?:component|interface|import|pageencoding|public|private|package|remote|static|final|abstract)\\b|//|/\\*)"
      },
      "startTokens": [
        "ScriptExpression"
      ]
    }
  ],
  "tokens": {
    "ScriptTagPair": {
      "type": "GroupAllChildrenInSameOrder",
      "multiLine": true,
      "nestedTokens": [
        "ScriptStartTag",
        "ScriptExpression",
        "ScriptEndTag"
      ]
    },
    "ScriptStartTag": {
      "type": "StartStop",
      "startRegex": "<cfscript(?=[\\>\\s])",
      "endRegex": "\\/?>",
      "multiLine": true,
      "textColor": "0xabd90c",
      "nestedTokens": [
        "Expression"
      ]
    },
    "ScriptEndTag": {
      "type": "SimpleToken",
      "startRegex": "<\\/cfscript>",
      "textColor": "0xabd90c"
    },
    "OutputTagPair": {
      "type": "GroupAllChildrenInSameOrder",
      "otherTextInside": true,
      "multiLine": true,
      "nestedTokens": [
        "OutputStartTag",
        "OutputExpression",
        "OutputEndTag"
      ]
    },
    "OutputStartTag": {
      "type": "StartStop",
      "startRegex": "<cfoutput(?=[\\>\\s])",
      "endRegex": "\\/?>",
      "multiLine": true,
      "textColor": "0xabd90c",
      "nestedTokens": [
        "Expression"
      ]
    },
    "OutputEndTag": {
      "type": "SimpleToken",
      "startRegex": "<\\/cfoutput>",
      "textColor": "0xabd90c"
    },
    "QueryTagPair": {
      "type": "GroupAllChildrenInSameOrder",
      "multiLine": true,
      "nestedTokens": [
        "QueryStartTag",
        "QueryExpression",
        "QueryEndTag"
      ]
    },
    "QueryStartTag": {
      "type": "StartStop",
      "startRegex": "<cfquery(?=[\\>\\s])",
      "endRegex": "\\/?>",
      "multiLine": true,
      "textColor": "0xabd90c",
      "nestedTokens": [
        "Expression"
      ]
    },
    "QueryEndTag": {
      "type": "SimpleToken",
      "startRegex": "<\\/cfquery>",
      "textColor": "0xabd90c"
    },
    "LoopTagPair": {
      "type": "GroupAllChildrenInSameOrder",
      "multiLine": true,
      "nestedTokens": [
        "LoopStartTag",
        "LoopExpression",
        "LoopEndTag"
      ]
    },
    "LoopStartTag": {
      "type": "StartStop",
      "startRegex": "<cfloop(?=[\\>\\s])",
      "endRegex": "\\/?>",
      "multiLine": true,
      "textColor": "0xabd90c",
      "nestedTokens": [
        "Expression"
      ]
    },
    "LoopEndTag": {
      "type": "SimpleToken",
      "startRegex": "<\\/cfloop>",
      "textColor": "0xabd90c"
    },
    "MailTagPair": {
      "type": "GroupAllChildrenInSameOrder",
      "otherTextInside": true,
      "multiLine": true,
      "nestedTokens": [
        "MailStartTag",
        "OutputExpression",
        "MailEndTag"
      ]
    },
    "MailStartTag": {
      "type": "StartStop",
      "startRegex": "<cfmail(?=[\\>\\s])",
      "endRegex": "\\/?>",
      "multiLine": true,
      "textColor": "0xabd90c",
      "nestedTokens": [
        "Expression"
      ]
    },
    "MailEndTag": {
      "type": "SimpleToken",
      "startRegex": "<\\/cfmail>",
      "textColor": "0xabd90c"
    },
    "SavecontentTagPair": {
      "type": "GroupAllChildrenInSameOrder",
      "otherTextInside": true,
      "multiLine": true,
      "nestedTokens": [
        "SavecontentStartTag",
        "OutputExpression",
        "SavecontentEndTag"
      ]
    },
    "SavecontentStartTag": {
      "type": "StartStop",
      "startRegex": "<cfsavecontent(?=[\\>\\s])",
      "endRegex": "\\/?>",
      "multiLine": true,
      "textColor": "0xabd90c",
      "nestedTokens": [
        "Expression"
      ]
    },
    "SavecontentEndTag": {
      "type": "SimpleToken",
      "startRegex": "<\\/cfsavecontent>",
      "textColor": "0xabd90c"
    },
    "StartTag": {
      "type": "StartStop",
      "startRegex": "<(?:cf[a-z0-9_]*|[a-z0-9_]+:[a-z0-9_]+)",
      "endRegex": "\\/?>",
      "multiLine": true,
      "textColor": "0xabd90c",
      "nestedTokens": [
        "Expression"
      ]
    },
    "EndTag": {
      "type": "StartStop",
      "startRegex": "<\\/(?:cf(?!output)(?!script)(?!query)(?!loop)(?!mail)(?!savecontent)[a-z0-9_]*|[a-z0-9_]+:[a-z0-9_]+)",
      "endRegex": "\\/?>",
      "multiLine": true,
      "textColor": "0xabd90c",
      "nestedTokens": [
        "Expression"
      ]
    },
    "Comment": {
      "type": "StartStop",
      "startRegex": "<!---",
      "endRegex": "--->",
      "multiLine": true,
      "otherTextInside": true,
      "nestedTokens": [
        "Comment"
      ]
    },
    "SingleString": {
      "type": "StartStop",
      "startRegex": "'",
      "endRegex": "'",
      "multiLine": true,
      "otherTextInside": true,
      "searchParentEndTokenLast": true,
      "textColor": "0xce9178",
      "nestedTokens": [
        "SharpChar",
        "SharpExpression",
        "SingleChar"
      ],
      "delimiterTextColor": "0x9e6a57"
    },
    "DoubleString": {
      "type": "StartStop",
      "startRegex": "\"",
      "endRegex": "\"",
      "multiLine": true,
      "otherTextInside": true,
      "searchParentEndTokenLast": true,
      "textColor": "0xce9178",
      "nestedTokens": [
        "SharpChar",
        "SharpExpression",
        "DoubleChar"
      ],
      "delimiterTextColor": "0x9e6a57"
    },
    "SingleChar": {
      "type": "SimpleToken",
      "startRegex": "''",
      "textColor": "0xd7ba7d"
    },
    "DoubleChar": {
      "type": "SimpleToken",
      "startRegex": "\"\"",
      "textColor": "0xd7ba7d"
    },
    "SharpChar": {
      "type": "SimpleToken",
      "startRegex": "##",
      "textColor": "0xd7ba7d"
    },
    "SharpExpression": {
      "type": "StartStop",
      "startRegex": "#",
      "endRegex": "#",
      "multiLine": true,
      "textColor": "0x569cd6",
      "nestedTokens": [
        "Expression",
        "ExpressionEnd"
      ]
    },
    "Expression": {
      "type": "Group",
      "multiLine": true,
      "deleteIfOnlyOneChild": true,
      "nestedTokens": [
        "SingleString",
        "DoubleString",
        "SharpChar",
        "SharpExpression",
        "Separator",
        "SpreadOperator",
        "ScriptLineComment",
        "ScriptBlockComment",
        "ExpressionEnd",
        "Number",
        "Boolean",
        "Keyword",
        "Function",
        "Operator",
        "ObjectMember",
        "Variable",
        "CodeBlock",
        "Parenthesis",
        "ArrayIndex"
      ]
    },
    "ScriptExpression": {
      "type": "Group",
      "multiLine": true,
      "nestedTokens": [
        "SingleString",
        "DoubleString",
        "SharpChar",
        "SharpExpression",
        "Separator",
        "SpreadOperator",
        "CodeBlock",
        "ScriptLineComment",
        "ScriptBlockComment",
        "ExpressionEnd",
        "Number",
        "Boolean",
        "Keyword",
        "Function",
        "Operator",
        "ObjectMember",
        "Variable",
        "Parenthesis",
        "ArrayIndex"
      ]
    },
    "OutputExpression": {
      "type": "Group",
      "otherTextInside": true,
      "multiLine": true,
      "nestedTokens": [
        "ScriptTagPair",
        "OutputTagPair",
        "QueryTagPair",
        "LoopTagPair",
        "MailTagPair",
        "SavecontentTagPair",
        "StartTag",
        "EndTag",
        "Comment",
        "SharpChar",
        "SharpExpression"
      ]
    },
    "QueryExpression": {
      "type": "Group",
      "otherTextInside": true,
      "multiLine": true,
      "nestedTokens": [
        "ScriptTagPair",
        "OutputTagPair",
        "QueryTagPair",
        "LoopTagPair",
        "MailTagPair",
        "SavecontentTagPair",
        "StartTag",
        "EndTag",
        "Comment",
        "SharpChar",
        "SharpExpression"
      ]
    },
    "LoopExpression": {
      "type": "Group",
      "otherTextInside": true,
      "multiLine": true,
      "nestedTokens": [
        "ScriptTagPair",
        "OutputTagPair",
        "QueryTagPair",
        "LoopTagPair",
        "MailTagPair",
        "SavecontentTagPair",
        "StartTag",
        "EndTag",
        "Comment"
      ],
      "contextNestedTokens": [
        {
          "whenParentIn": [
            "OutputExpression",
            "QueryExpression",
            "OutputTagPair",
            "QueryTagPair",
            "MailTagPair",
            "SavecontentTagPair"
          ],
          "nestedTokens": [
            "ScriptTagPair",
            "OutputTagPair",
            "QueryTagPair",
            "LoopTagPair",
            "MailTagPair",
            "SavecontentTagPair",
            "StartTag",
            "EndTag",
            "Comment",
            "SharpChar",
            "SharpExpression"
          ]
        }
      ]
    },
    "ScriptBlockComment": {
      "type": "StartStop",
      "startRegex": "\\/\\*",
      "endRegex": "\\*\\/",
      "otherTextInside": true,
      "multiLine": true
    },
    "ScriptLineComment": {
      "type": "SimpleToken",
      "startRegex": "\\/\\/.*[^\\r\\n]"
    },
    "ExpressionEnd": {
      "type": "SimpleToken",
      "startRegex": ";"
    },
    "Number": {
      "type": "SimpleToken",
      "startRegex": "([0-9]+\\.?[0-9]*(?:e[-+]?[0-9]+)?|[0-9]*\\.[0-9]+(?:e[-+]?[0-9]+)?)",
      "textColor": "0xb5cea8"
    },
    "Boolean": {
      "type": "SimpleToken",
      "startRegex": "true\\b|false\\b|yes\\b|no\\b"
    },
    "ObjectMember": {
      "type": "SimpleToken",
      "startRegex": "\\?\\.|\\."
    },
    "Function": {
      "type": "SimpleToken",
      "startRegex": "([a-z_]+[a-z0-9_]*)[\\s]*\\(",
      "textColor": "0xc5f566"
    },
    "Separator": {
      "type": "SimpleToken",
      "startRegex": ","
    },
    "SpreadOperator": {
      "type": "SimpleToken",
      "startRegex": "\\.\\.\\.",
      "textColor": "0x35b2dd"
    },
    "Variable": {
      "type": "SimpleToken",
      "startRegex": "[a-z_\\$]+[a-z0-9_\\$]*",
      "textColor": "0x9cdcfe"
    },
    "LambdaOperator": {
      "type": "SimpleToken",
      "startRegex": "=>",
      "textColor": "0x35b2dd"
    },
    "AssignOperator": {
      "type": "SimpleToken",
      "startRegex": "\\+=|\\-=|\\*=|\\/=|%=|&=|=",
      "textColor": "0x35b2dd"
    },
    "TernaryOperator": {
      "type": "SimpleToken",
      "startRegex": "\\?\\?|\\?:|\\?|\\:",
      "textColor": "0x35b2dd"
    },
    "LogicalImpOperator": {
      "type": "SimpleToken",
      "startRegex": "imp\\b",
      "textColor": "0x35b2dd"
    },
    "LogicalEqvOperator": {
      "type": "SimpleToken",
      "startRegex": "eqv\\b",
      "textColor": "0x35b2dd"
    },
    "LogicalXorOperator": {
      "type": "SimpleToken",
      "startRegex": "xor\\b",
      "textColor": "0x35b2dd"
    },
    "LogicalOrOperator": {
      "type": "SimpleToken",
      "startRegex": "\\|\\||or\\b",
      "textColor": "0x35b2dd"
    },
    "LogicalAndOperator": {
      "type": "SimpleToken",
      "startRegex": "\\&\\&|and\\b",
      "textColor": "0x35b2dd"
    },
    "LogicalNotOperator": {
      "type": "SimpleToken",
      "startRegex": "not\\b|!",
      "textColor": "0x35b2dd"
    },
    "CompareOperator": {
      "type": "SimpleToken",
      "startRegex": "greater\\s+than\\s+or\\s+equal\\s+to\\b|less\\s+than\\s+or\\s+equal\\s+to\\b|does\\s+not\\s+contain\\b|is\\s+not\\b|contains\\b|less\\s+than\\b|greater\\s+than\\b|not\\s+equal\\b|equal\\b|neq\\b|lte\\b|gte\\b|eq\\b|===|!==|==|>=|<=|!=|ge\\b|lt\\b|gt\\b|le\\b|\\bis\\b|>|<",
      "textColor": "0x35b2dd"
    },
    "ConcatOperator": {
      "type": "SimpleToken",
      "startRegex": "\\&",
      "textColor": "0x35b2dd"
    },
    "IncDecOperator": {
      "type": "SimpleToken",
      "startRegex": "\\+\\+|\\-\\-",
      "textColor": "0x35b2dd"
    },
    "AddOperator": {
      "type": "SimpleToken",
      "startRegex": "\\+|-",
      "textColor": "0x35b2dd"
    },
    "MulOperator": {
      "type": "SimpleToken",
      "startRegex": "\\*|\\/|\\\\|mod\\b|\\%",
      "textColor": "0x35b2dd"
    },
    "PowerOperator": {
      "type": "SimpleToken",
      "startRegex": "\\^",
      "textColor": "0x35b2dd"
    },
    "Operator": {
      "type": "Group",
      "multiLine": true,
      "deleteIfOnlyOneChild": true,
      "nestedTokens": [
        "LambdaOperator",
        "CompareOperator",
        "AssignOperator",
        "TernaryOperator",
        "LogicalImpOperator",
        "LogicalEqvOperator",
        "LogicalXorOperator",
        "LogicalOrOperator",
        "LogicalAndOperator",
        "LogicalNotOperator",
        "ConcatOperator",
        "IncDecOperator",
        "AddOperator",
        "MulOperator",
        "PowerOperator"
      ]
    },
    "CodeBlock": {
      "type": "StartStop",
      "startRegex": "\\{",
      "endRegex": "\\}",
      "multiLine": true,
      "textColor": "0xffd700",
      "nestedTokens": [
        "ScriptExpression"
      ]
    },
    "Keyword": {
      "type": "SimpleToken",
      "startRegex": "var\\b|function\\b|new\\b|this\\b|super\\b|null\\b|try\\b|catch\\b|finally\\b|if\\b|then\\b|else\\b|switch\\b|case\\b|default\\b|break\\b|continue\\b|while\\b|do\\b|for\\b|in\\b|return\\b|throw\\b|rethrow\\b|retry\\b|component\\b|interface\\b|property\\b|pageencoding\\b|import\\b|include\\b|param\\b|lock\\b|transaction\\b|thread\\b|public\\b|private\\b|remote\\b|package\\b|static\\b|final\\b|abstract\\b|required\\b",
      "textColor": "0xc586c0"
    },
    "Parenthesis": {
      "type": "StartStop",
      "startRegex": "\\(",
      "endRegex": "\\)",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xffd700",
      "nestedTokens": [
        "ScriptTagPair",
        "OutputTagPair",
        "QueryTagPair",
        "LoopTagPair",
        "MailTagPair",
        "SavecontentTagPair",
        "StartTag",
        "EndTag",
        "Comment",
        "ScriptStartTag",
        "ScriptExpression",
        "ScriptEndTag",
        "Expression",
        "OutputStartTag",
        "OutputExpression",
        "OutputEndTag",
        "QueryStartTag",
        "QueryExpression",
        "QueryEndTag",
        "LoopStartTag",
        "LoopExpression",
        "LoopEndTag",
        "MailStartTag",
        "MailEndTag",
        "SavecontentStartTag",
        "SavecontentEndTag",
        "SharpChar",
        "SharpExpression",
        "ExpressionEnd",
        "SingleString",
        "DoubleString",
        "Separator",
        "SpreadOperator",
        "ScriptLineComment",
        "ScriptBlockComment",
        "Number",
        "Boolean",
        "Keyword",
        "Function",
        "Operator",
        "ObjectMember",
        "Variable",
        "CodeBlock",
        "Parenthesis",
        "ArrayIndex"
      ]
    },
    "ArrayIndex": {
      "type": "StartStop",
      "startRegex": "\\[",
      "endRegex": "\\]",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xffd700",
      "nestedTokens": [
        "ScriptTagPair",
        "OutputTagPair",
        "QueryTagPair",
        "LoopTagPair",
        "MailTagPair",
        "SavecontentTagPair",
        "StartTag",
        "EndTag",
        "Comment",
        "ScriptStartTag",
        "ScriptExpression",
        "ScriptEndTag",
        "Expression",
        "OutputStartTag",
        "OutputExpression",
        "OutputEndTag",
        "QueryStartTag",
        "QueryExpression",
        "QueryEndTag",
        "LoopStartTag",
        "LoopExpression",
        "LoopEndTag",
        "MailStartTag",
        "MailEndTag",
        "SavecontentStartTag",
        "SavecontentEndTag",
        "SharpChar",
        "SharpExpression",
        "ExpressionEnd",
        "SingleString",
        "DoubleString",
        "Separator",
        "SpreadOperator",
        "ScriptLineComment",
        "ScriptBlockComment",
        "Number",
        "Boolean",
        "Keyword",
        "Function",
        "Operator",
        "ObjectMember",
        "Variable",
        "CodeBlock",
        "Parenthesis",
        "ArrayIndex"
      ]
    }
  },
  "operator_precedence": [
    {
      "operators": [
        "LambdaOperator"
      ],
      "associativity": "right"
    },
    {
      "operators": [
        "AssignOperator"
      ],
      "associativity": "right"
    },
    {
      "operators": [
        "TernaryOperator"
      ],
      "associativity": "right"
    },
    {
      "operators": [
        "LogicalImpOperator"
      ],
      "associativity": "left"
    },
    {
      "operators": [
        "LogicalEqvOperator"
      ],
      "associativity": "left"
    },
    {
      "operators": [
        "LogicalXorOperator"
      ],
      "associativity": "left"
    },
    {
      "operators": [
        "LogicalOrOperator"
      ],
      "associativity": "left"
    },
    {
      "operators": [
        "LogicalAndOperator"
      ],
      "associativity": "left"
    },
    {
      "operators": [
        "LogicalNotOperator"
      ],
      "associativity": "right"
    },
    {
      "operators": [
        "CompareOperator"
      ],
      "associativity": "left"
    },
    {
      "operators": [
        "ConcatOperator"
      ],
      "associativity": "left"
    },
    {
      "operators": [
        "AddOperator"
      ],
      "associativity": "left"
    },
    {
      "operators": [
        "MulOperator"
      ],
      "associativity": "left"
    },
    {
      "operators": [
        "PowerOperator"
      ],
      "associativity": "left"
    }
  ]
}
