<cfset base = GetDirectoryFromPath(GetCurrentTemplatePath()) /><cfset noSlash = Left(base, Len(base) - 1) /><cfset r1 = ExpandPath(".") EQ noSlash /><cfset r2 = ExpandPath("./") EQ base /><cfset r3 = ExpandPath("/tmp") EQ (base & "tmp") /><cfset r4 = ExpandPath("/tmp/") EQ (base & "tmp/") /><cfset r5 = ExpandPath("a") EQ (base & "a") /><cfset r6 = ExpandPath("a/b") EQ (base & "a/b") /><cfset r7 = ExpandPath("a/../b") EQ (base & "b") /><cfset r8 = ExpandPath("a/") EQ (base & "a/") /><cfoutput>dot:#r1#|dotSlash:#r2#|slashTmp:#r3#|slashTmpSlash:#r4#|a:#r5#|aSlashB:#r6#|aDotDotB:#r7#|aSlash:#r8#|</cfoutput>
