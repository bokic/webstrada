<!--- ImageGetEXIFMetadata / ImageGetEXIFTag verified byte-for-byte against
CF 2025 (RDS host). The embedded JPEGs carry hand-built EXIF/IPTC data that
com.drew (the library behind CF's Image class) reports as the structs below.
--->
<cfset sep = "~">
<cfset pe = ExpandPath("img_meta_e.jpg")>
<cfset FileWrite(pe, BinaryDecode("", "base64"))>
<cfset imE = ImageRead(pe)>
<cfoutput>#sep#EXIF:#SerializeJSON(ImageGetEXIFMetadata(imE))#</cfoutput>
<cfoutput>#sep#MAKE:#ImageGetEXIFTag(imE, "Make")#</cfoutput>
<cfoutput>#sep#MODEL:#ImageGetEXIFTag(imE, "Model")#</cfoutput>
<cfoutput>#sep#LOW:#ImageGetEXIFTag(imE, "make")#</cfoutput>
<cfoutput>#sep#ORIENT:#ImageGetEXIFTag(imE, "Orientation")#</cfoutput>
<cfoutput>#sep#EXPOSURE:#ImageGetEXIFTag(imE, "Exposure Time")#</cfoutput>
<cfoutput>#sep#MISSING:#ImageGetEXIFTag(imE, "NoSuchTag")#</cfoutput>
<cfoutput>#sep#FNUM:#ImageGetEXIFTag(imE, "F-Number")#</cfoutput>
<cfset pe2 = ExpandPath("img_meta_e2.jpg")>
<cfset FileWrite(pe2, BinaryDecode("", "base64"))>
<cfset imE2 = ImageRead(pe2)>
<cfoutput>#sep#EXIF2:#SerializeJSON(ImageGetEXIFMetadata(imE2))#</cfoutput>
<cfoutput>#sep#EXIF2_MAKE:#ImageGetEXIFTag(imE2, "Make")#</cfoutput>

<cfset pg = ExpandPath("img_meta_g.jpg")>
<cfset FileWrite(pg, BinaryDecode("", "base64"))>
<cfset imG = ImageRead(pg)>
<cfoutput>#sep#GPS_LAT:#ImageGetEXIFTag(imG, "GPS Latitude")#</cfoutput>
<cfoutput>#sep#GPS_VERSION:#ImageGetEXIFTag(imG, "GPS Version ID")#</cfoutput>
<cfoutput>#sep#GPS_STATUS:#ImageGetEXIFTag(imG, "GPS Status")#</cfoutput>
