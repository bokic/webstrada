<!--- ImageGetIPTCMetadata / ImageGetIPTCTag verified byte-for-byte against
CF 2025 (RDS host). --->
<cfset sep = "~">
<cfset pi = ExpandPath("img_meta_i.jpg")>
<cfset FileWrite(pi, BinaryDecode("", "base64"))>
<cfset imI = ImageRead(pi)>
<cfoutput>#sep#IPTC:#SerializeJSON(ImageGetIPTCMetadata(imI))#</cfoutput>
<cfoutput>#sep#BYLINE:#ImageGetIPTCTag(imI, "By-line")#</cfoutput>
<cfoutput>#sep#OBJNAME:#ImageGetIPTCTag(imI, "Object Name")#</cfoutput>
<cfoutput>#sep#URGENCY:#ImageGetIPTCTag(imI, "Urgency")#</cfoutput>
<cfoutput>#sep#MISSING:#ImageGetIPTCTag(imI, "NoSuchTag")#</cfoutput>
