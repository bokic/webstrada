<cfset base_path = GetDirectoryFromPath(GetCurrentTemplatePath()) /><cfset test_dir = base_path & "test_temp_dir" /><cfif DirectoryExists(test_dir)><cfset DirectoryDelete(test_dir, true) /></cfif><cfset exists_before = DirectoryExists(test_dir) /><cfset DirectoryCreate(test_dir) /><cfset exists_after = DirectoryExists(test_dir) /><cfset file_path = test_dir & "/test.txt" /><cfset FileWrite(file_path, "Hello CFML!") /><cfset file_exists_before = FileExists(file_path) /><cfset content = FileRead(file_path) /><cfset copy_path = test_dir & "/test_copy.txt" /><cfset FileCopy(file_path, copy_path) /><cfset copy_exists = FileExists(copy_path) /><cfset moved_path = test_dir & "/test_moved.txt" /><cfset FileMove(copy_path, moved_path) /><cfset copy_exists_after = FileExists(copy_path) /><cfset moved_exists = FileExists(moved_path) /><cfset FileDelete(file_path) /><cfset FileDelete(moved_path) /><cfset DirectoryDelete(test_dir) /><cfset exists_final = DirectoryExists(test_dir) /><cfoutput>DirBefore:<cfif exists_before>YES<cfelse>NO</cfif>|DirAfter:<cfif exists_after>YES<cfelse>NO</cfif>|FileExists:<cfif file_exists_before>YES<cfelse>NO</cfif>|Content:#Trim(content)#|CopyExists:<cfif copy_exists>YES<cfelse>NO</cfif>|CopyExistsAfter:<cfif copy_exists_after>YES<cfelse>NO</cfif>|MovedExists:<cfif moved_exists>YES<cfelse>NO</cfif>|DirFinal:<cfif exists_final>YES<cfelse>NO</cfif></cfoutput>
